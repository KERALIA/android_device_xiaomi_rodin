# Display Configuration
ro.vendor.display.type=oled
ro.vendor.xiaomi.bl.poll=true
ro.vendor.hbm_backlight.enable=true
persist.vendor.dc_backlight.enable=false
ro.vendor.cabc.enable=false
ro.vendor.bcbc.enable=true
ro.vendor.colorpick_adjust=true
ro.vendor.all_modes.colorpick_adjust=true
ro.vendor.whitepoint_calibration_enable=false
ro.vendor.display.all_modes_support_WCG.enable=true
ro.vendor.localhbm.enable=true
ro.vendor.sre.enable=false
ro.vendor.gcp.enable=true
ro.vendor.display.update_gray_by_temperature=true
ro.vendor.mtk.pq.aidl=true
ro.vendor.mtk.pq.odm=true
ro.vendor.display.dolbyvision.support=false
ro.vendor.standard.video.enable=true
ro.vendor.media.video.style.support=true
ro.vendor.sdr2hdr.by.layer.support=false
ro.vendor.regionpq.by.layer.support=true
ro.vendor.display.uiservice.enable=true
ro.vendor.display.uiservice_track.enable=true
ro.vendor.display.uiservice_tpidle_timer.enable=true
ro.vendor.display.uiservice_snm.enable=true

# Refresh Rate & FPS
ro.vendor.display.default_fps=120
ro.vendor.fps.switch.default=true
ro.vendor.fps.switch.thermal=false
ro.vendor.idle_fps=60
ro.vendor.display.tp_idle_fps=60
ro.vendor.disable_idle_fps.threshold=966
ro.vendor.display.touch.idle.enable=true
ro.surface_flinger.set_touch_timer_ms=1100
debug.sf.set_idle_timer_ms=1100
debug.sf.default_idle_timer_ms=1100
ro.vendor.display.fod_monitor_default_fps=120
ro.vendor.display.heartrate_lockfps_support=true
ro.vendor.display.aod_monitor_default_fps=60
ro.vendor.display.ultimate.perf.support=true
ro.vendor.display.frame_capture_manager.enable=true

# Display Properties
vendor.display.default_resolution=1220,2712
ro.vendor.display.RemapBrightness.ToleranceEnable=1
ro.vendor.display.RemapBrightness.ToleranceNit=500
ro.vendor.display.RemapBrightness.MinTolerancefac=1
ro.vendor.display.RemapBrightness.MaxTolerancefac=1.09
ro.vendor.display.RemapBrightness.MaxRemapSilkybrightness=16379
ro.vendor.display.video_or_camera_fps.support=true
sys.displayfeature_hidl=false
vendor.displayfeature_entry.enable=true
vendor.display.force_tonemapping=1

# VSYNC Durations (120Hz)
debug.sf.high_fps.late.sf.duration=13800000
debug.sf.high_fps.late.app.duration=11100000
debug.sf.high_fps.early.sf.duration=13800000
debug.sf.high_fps.early.app.duration=11100000
debug.sf.high_fps.earlyGl.sf.duration=13800000
debug.sf.high_fps.earlyGl.app.duration=11100000
ro.surface_flinger.enable_frame_rate_override=false

# Touch & Input
ro.vendor.touch.touchscheduler.enable=true
ro.vendor.touch.touchflinger.enable=true
persist.vendor.touchfeature.gameturbotool.version=v3.5

# Camera
persist.vendor.vcb.ability=true
persist.vendor.vcb.enable=false
ro.product.camera.livephoto.support=3

# NFC
ro.vendor.se.type=HCE,UICC
ro.vendor.se.chip.model=SN220T
ro.vendor.nfc.disable.i2c=false
ro.vendor.se.info=19-1010212
ro.vendor.nfc.repair=1
ro.vendor.nfc.dispatch_optim=2
ro.vendor.nfc.wallet_fusion=1
ro.vendor.nfc.debounce_field_on=1
ro.vendor.nfc.field_on_debounce=800

# Haptic/Vibrator
ro.odm.mm.vibrator.sys_path=/sys/bus/i2c/drivers/awinic_haptic/0-005a
ro.odm.mm.vibrator.device_type=ff
ro.odm.mm.vibrator.diff_f0=1
ro.odm.mm.vibrator.resonant_frequency=170
ro.odm.mm.vibrator.si_sys_path=/sys/bus/i2c/drivers/sih_haptic_688X/0-006b
ro.odm.mm.vibrator.aac_sys_path=/sys/bus/i2c/drivers/haptic_rt/0-005f
sys.haptic.motor=linear
sys.haptic.infinitelevel=true
sys.haptic.dynamiceffect=true
sys.haptic.dynamiceffect.richtap=true
sys.haptic.dynamiceffect.richtap.version=1.0
sys.haptic.intensityforkeyboard=true
sys.haptic.BCLMode=true
sys.haptic.onetrack=true
sys.haptic.version=2.0

# Haptic Presets
sys.haptic.down.weak=0
sys.haptic.down.normal=2
sys.haptic.down.strong=5
sys.haptic.down=5,2
sys.haptic.tap.normal=3,2
sys.haptic.tap.light=5,2
sys.haptic.flick=5,2
sys.haptic.flick.light=7,2
sys.haptic.switch=9,2
sys.haptic.mesh.heavy=8,2
sys.haptic.mesh.normal=5,2
sys.haptic.mesh.light=5,1
sys.haptic.long.press=0,1
sys.haptic.popup.normal=6,2
sys.haptic.popup.light=6,1
sys.haptic.pickup=2,2
sys.haptic.scroll.edge=7,0
sys.haptic.trigger.drawer=2,0
sys.haptic.hold=4,0
sys.haptic.runin=13
sys.haptic.boundary_spatial=0,2
sys.haptic.boundary_time=1,2
sys.haptic.button_large=2,2
sys.haptic.button_middle=3,2
sys.haptic.button_small=4,2
sys.haptic.gear_light=5,2
sys.haptic.gear_heavy=6,2
sys.haptic.keyboard=7,2
sys.haptic.alert=8,2
sys.haptic.zaxis_switch=9,2
ro.odm.mm.vibrator.lowPowerMode=true

# Audio
persist.vendor.audio.silencelowpower.support=false
ro.vendor.soundtrigger.dfs.support=1
persist.vendor.audio.csd=true
persist.vendor.audio.csd.gain=5
ro.vendor.audio.seaaudio.model=false
vendor.audio.useXiaomiSpatializer=false
audio.spatializer.pose_predictor_type=2
audio.spatializer.prediction_duration_ms=50
persist.vendor.audio.effectimplenter=dolby
persist.vendor.audio.cinema.support=true
ro.vendor.audio.dolby.vision.support=false
persist.vendor.audio.musiclight.update.freq=40
ro.vendor.audio.screenrecorder.bothrecord=1
ro.vendor.audio.fweffect=true
ro.vendor.audio.ear.scan.support=true
ro.vendor.audio.support.sound.id=true
persist.vendor.audio.ultrasoundmute.support=true
ro.vendor.audio.active.detection=2

# Media & Codec
debug.config.video.p3.encode.support=true
debug.config.video.p3.decode.support=true
debug.config.media.video.frc.support=true
debug.config.media.video.ais.support=true
debug.config.media.video.server.support=true
debug.game.video.support=true
debug.config.media.video.dolby_vision_suports=false

# Battery & Charging
persist.vendor.tracking.dfs=true
persist.vendor.battery.health=true
persist.vendor.battery.health.optimise=true
persist.vendor.extreme.mode=true
persist.vendor.battery.erp=true
persist.vendor.doublentc=1
persist.vendor.low.cutoff=true
persist.vendor.night.charge=true
persist.vendor.smart.battMntor.V2=true
persist.vendor.region.charger=default

# Sensor
persist.vendor.sensor.onetrack=true
persist.vendor.sensor.maxbrightness=2600
persist.vendor.sensor.powbrightness=10
ro.miui.support.aon.facecpu=1

# Performance
ro.vendor.xiaomi.sr.support=false

# Property Source & Imports
ro.product.property_source_order=odm,product,vendor,system_ext,system
import /odm/etc/rodin_${ro.boot.ptcountrycode}_build.prop
import /odm/etc/${ro.boot.product.hardware.sku}_${ro.boot.hwversion}.prop

