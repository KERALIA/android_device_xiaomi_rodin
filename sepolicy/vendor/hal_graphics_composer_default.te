hal_client_domain(hal_graphics_composer_default, vendor_hal_displayfeature)
hal_server_domain(hal_graphics_composer_default, vendor_hal_citsensorservice_xiaomi)

binder_call(hal_graphics_composer_default, vendor_hal_citsensorservice_xiaomi_default)

allow hal_graphics_composer_default sysfs_leds:dir r_dir_perms;
allow hal_graphics_composer_default sysfs_leds:file rw_file_perms;
allow hal_graphics_composer_default vendor_displayfeature_sysfs:dir r_dir_perms;
allow hal_graphics_composer_default vendor_displayfeature_sysfs:file rw_file_perms;

allow hal_graphics_composer_default vendor_displayfeature_device:chr_file r_file_perms;

get_prop(hal_graphics_composer_default, vendor_displayfeature_prop)
